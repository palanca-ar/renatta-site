# Default para todo: security headers (sin cache-control aquí)
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

# Fotos del catálogo: cache largo
/fotos/*
  Cache-Control: public, max-age=604800, immutable

# HTMLs: SIEMPRE revalidar (última regla gana en Netlify) — F5 normal alcanza
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/panel.html
  Cache-Control: public, max-age=0, must-revalidate
/dashboard.html
  Cache-Control: public, max-age=0, must-revalidate
